-- 뽑기 버튼·뽑기 칸·결과 연출의 보급 상자 그림 (Roblox 에 올린 이미지 Id, 512x512 투명 바탕). 비어 있으면 Frame 으로 그림
Catalog.GachaIcon = "rbxassetid://88751191089595" :: string
Catalog.IconTile = 256
Catalog.IconGrid = 4
Catalog.Shapes = 5

-- 레어도마다 모양 (희귀할수록 화려한 모양): 일반은 앞 절반(7개) 모양 1, 뒤 절반 모양 2, 희귀 3, 영웅 4, 전설 5
function Catalog.shapeFor(rarity: number, index: number): number
	if rarity <= 1 then
		return if index <= math.ceil(Catalog.PerRarity[1] / 2) then 1 else 2
	end
	return math.min(rarity + 1, Catalog.Shapes)
end

